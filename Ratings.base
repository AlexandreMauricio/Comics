filters:
  and:
    - file.inFolder("Books")
properties:
  file.name:
    displayName: Book
  goodreads_rating:
    displayName: Goodreads
  goodreads_votes:
    displayName: Ratings
  my_rating:
    displayName: Mine
  ai_tier:
    displayName: AI tier
views:
  - type: table
    name: Best rated first
    filters:
      and:
        - 'goodreads_rating > 0'
    order:
      - file.name
      - line
      - goodreads_rating
      - goodreads_votes
      - my_rating
      - ai_tier
      - status
      - read
    sort:
      - property: goodreads_rating
        direction: DESC
  - type: table
    name: My ratings
    filters:
      and:
        - 'my_rating > 0'
    order:
      - file.name
      - line
      - my_rating
      - goodreads_rating
      - ai_tier
    sort:
      - property: my_rating
        direction: DESC
  - type: table
    name: Read, not rated yet
    filters:
      and:
        - 'read == true'
        - not:
            - 'my_rating > 0'
    order:
      - file.name
      - line
      - goodreads_rating
      - ai_tier
    sort:
      - property: line
        direction: ASC
      - property: seq
        direction: ASC
  - type: table
    name: Best rated I don't own yet
    filters:
      and:
        - 'goodreads_rating > 0'
        - or:
            - 'status == "wanted"'
            - 'status == "oop"'
            - 'status == "planned"'
            - 'status == "partial"'
    order:
      - file.name
      - line
      - goodreads_rating
      - goodreads_votes
      - status
      - price_seen
      - store
    sort:
      - property: goodreads_rating
        direction: DESC
  - type: table
    name: Best rated I own and haven't read
    filters:
      and:
        - 'goodreads_rating > 0'
        - 'read == false'
        - or:
            - 'status == "owned"'
            - 'status == "covered"'
    order:
      - file.name
      - line
      - goodreads_rating
      - goodreads_votes
    sort:
      - property: goodreads_rating
        direction: DESC
