filters:
  and:
    - file.inFolder("Books")
    - 'verified == false'
    - 'status != "parked"'
    - 'status != "unreleased"'
properties:
  file.name:
    displayName: Book
views:
  - type: table
    name: Unverified books
    groupBy:
      property: line
      direction: ASC
    order:
      - file.name
      - issues
      - isbn
      - source
      - ai_source
    sort:
      - property: seq
        direction: ASC
  - type: table
    name: Before buying
    filters:
      or:
        - 'status == "wanted"'
        - 'status == "planned"'
        - 'status == "partial"'
        - 'status == "oop"'
    order:
      - file.name
      - line
      - status
      - issues
      - isbn
      - price_seen
      - store
      - source
    sort:
      - property: line
        direction: ASC
      - property: seq
        direction: ASC
